# Copy this file to .env and fill in real values for your machine.
# Never commit the real .env file.

# --- Server ---
NODE_ENV=development
# In production, leave PORT unset — the hosting platform (e.g. Render)
# injects it automatically and the app reads whatever value it provides.
PORT=4000
# Comma-separated list of origins allowed to call this API, with credentials.
# Must be the exact deployed frontend origin in production, e.g.:
#   CORS_ORIGIN=https://your-project.pages.dev
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# PostgreSQL connection string. Create a dedicated database and role;
# do not use the postgres superuser for the application. In production,
# use a managed Postgres provider's connection string (e.g. Neon) — it
# already includes `sslmode=require`.
DATABASE_URL="postgresql://appointment_app:CHANGE_ME@localhost:5432/appointment_booking?schema=public"
# Used only when running the test suite (npm test).
TEST_DATABASE_URL="postgresql://appointment_app:CHANGE_ME@localhost:5432/appointment_booking_test?schema=public"

# --- Auth ---
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- Logging ---
LOG_LEVEL=info
