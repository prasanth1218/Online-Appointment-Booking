# Base URL of the backend API. In local development the Vite dev server
# proxies /api to the backend automatically (see vite.config.ts), so this
# can usually be left as "/api". In production (e.g. Cloudflare Pages), set
# it to the deployed backend's full URL, e.g.:
#   VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=/api
